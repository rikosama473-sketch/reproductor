{
  "name": "ritmo-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Fuentes compartidas y herramientas de validación para Ritmo móvil y PC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:web": "npm --prefix mobile run prepare:web",
    "android:init": "npm --prefix mobile run android:init",
    "android:sync": "npm --prefix mobile run android:sync",
    "desktop:prepare": "npm --prefix desktop run prepare",
    "desktop:start": "npm --prefix desktop run start",
    "validate": "node scripts/validate.mjs"
  }
}
